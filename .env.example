# LLM Provider Selection
LLM_PROVIDER=yandexgpt  # Options: yandexgpt, openrouter, mistral

# YandexGPT
YANDEX_GPT_API_KEY=your-yandexgpt-api-key-here
YANDEX_GPT_FOLDER_ID=your-folder-id-here
YANDEX_GPT_MODEL=yandexgpt-lite/latest
YANDEX_GPT_EMBEDDING_MODEL=text-search-query/latest
YANDEX_GPT_TIMEOUT=10
YANDEX_GPT_MAX_TOKENS=2000
YANDEX_GPT_TEMPERATURE=0.3

# OpenRouter (Free Models)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_TOKENS=2000
OPENROUTER_TEMPERATURE=0.7

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_TIMEOUT=30
MISTRAL_MAX_TOKENS=2000
MISTRAL_TEMPERATURE=0.3

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8100

# External APIs (replaced with free alternatives)
# Google Maps replaced with OpenRouteService (2000 requests/day free)
# Booking.com replaced with Amadeus API (2000 calls/month free)

# OpenRouteService (Free: 2000 requests/day)
# Get API key at: https://openrouteservice.org/
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key-here
OPENROUTESERVICE_TIMEOUT=10

# Amadeus API (Free: 2000 calls/month)
# Get API key at: https://developers.amadeus.com/
AMADEUS_API_KEY=your-amadeus-api-key-here
AMADEUS_API_SECRET=your-amadeus-secret-here
AMADEUS_TIMEOUT=10

# Nominatim (OpenStreetMap, Free: 1 req/sec)
NOMINATIM_USER_AGENT=trip-planner-ai-poc

# OpenTripMap API (Free: 5000 requests/day)
# Get API key at: https://dev.opentripmap.org/
OPENTRIPMAP_API_KEY=your-opentripmap-api-key-here
OPENTRIPMAP_TIMEOUT=10

# SerpApi (Google Hotels & Flights)
# Free tier: 100 searches/month
# Get API key at: https://serpapi.com/
SERPAPI_API_KEY=your-serpapi-api-key-here
SERPAPI_TIMEOUT=10

# Observability
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PG_USER=langfuse
LANGFUSE_PG_PASSWORD=changeme
LANGFUSE_SECRET=mysecret
LOG_LEVEL=INFO

# Application
SESSION_TTL_SECONDS=3600
SESSION_TOKEN_LIMIT=50000
MAX_ITERATIONS=3
REQUEST_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=60
CORS_ORIGINS=http://localhost:8501
